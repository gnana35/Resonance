NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Supabase — the app's database. Values from the dashboard: Settings -> API.
# The URL is a URL; do not paste a key here.
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Server-only keys. NO NEXT_PUBLIC_ prefix — that would inline them into the
# browser bundle where anyone can read them.

# REQUIRED for the World Map. /api/extract-entities uses this to derive
# entities, relationships and characters from chapter text. Without it,
# derivation fails silently on every chapter save and the map stays empty.
GOOGLE_API_KEY=your_google_ai_studio_key

# Research agent web search.
TAVILY_API_KEY=your_tavily_key

# ── LLM provider ────────────────────────────────────────────────────────────
# Which provider the entity extraction and research agent use.
#   groq    ~1000 requests/day free   <- use this for development
#   gemini  20 requests/day free      <- exhausts in one writing session
# Unset: whichever key is present, preferring Groq.
LLM_PROVIDER=groq

# Groq. Key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key
# Optional model override. Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Gemini model override. Default: gemini-2.0-flash
# Do not use gemini-2.5-flash — it is refused for new API keys.
GEMINI_MODEL=gemini-2.0-flash

# Chars of chapter text sent per extraction call. Groq's free tier caps TOKENS
# per minute (6000), and ~4 chars ≈ 1 token — so a 24k-char chapter alone eats
# the whole minute. 8000 keeps ~2 chapters/min. Raise on a paid tier.
EXTRACT_TEXT_LIMIT=8000

# Max completion tokens per extraction. Groq counts this reservation against
# tokens-per-minute, so it dominated usage at the old 4096. 1500 fits a normal
# extraction result. Raise if very dense chapters return truncated JSON (422).
EXTRACT_MAX_TOKENS=1500
